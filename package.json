{
  "name": "my-blog-plume",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "license": "MIT",
  "engines": {
    "node": "^20.6.0 || >=22.0.0"
  },
  "scripts": {
    "commit": "cz",
    "docs:dev": "pnpm run wordcount && vuepress dev docs",
    "docs:dev-clean": "vuepress dev docs --clean-cache --clean-temp",
    "docs:build": "pnpm run wordcount && vuepress build docs --clean-cache --clean-temp",
    "docs:preview": "http-server docs/.vuepress/dist",
    "vp-update": "pnpm dlx vp-update",
    "prebuild": "git fetch --unshallow || true",
    "wordcount": "node scripts/wordcount.cjs"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.1",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "@mdit-vue/shared": "^2.1.4",
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "http-server": "^14.1.1",
    "stylus": "^0.64.0",
    "twikoo": "^1.7.19",
    "typescript": "^5.9.3",
    "vue": "^3.5.41",
    "vue-feather-icons": "^5.1.0",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-plume": "1.0.0-rc.205"
  },
  "dependencies": {
    "@pinyin-pro/data": "^1.3.1",
    "my-blog-plume": "link:",
    "pinyin-pro": "^3.29.3",
    "postprocessing": "^6.39.4",
    "three": "^0.182.0"
  }
}
